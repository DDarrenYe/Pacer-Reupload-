# Copy to backend/.env and fill in. Never commit .env.

# Supabase -> Connect -> "Session pooler" connection string (works on IPv4 networks like Render).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Only for older projects that still use the legacy JWT secret. Leave blank otherwise.
SUPABASE_JWT_SECRET=

STORAGE_BUCKET=raw-uploads

# Demo account: a long random string switches the read-only demo on (empty = off).
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_TOKEN_SECRET=

# Strava import (optional; empty = off). Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Encrypts stored Strava tokens. Generate once and keep it: changing it disconnects everyone.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_TOKEN_KEY=
# Any random string; shared with Strava by scripts/strava_webhook.py.
STRAVA_WEBHOOK_VERIFY_TOKEN=
